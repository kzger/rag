# export OCR_MODEL_NAME=pipeline
# export YOLOX_HTTP_ENDPOINT=https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-page-elements-v3
# export YOLOX_INFER_PROTOCOL=http
# export YOLOX_GRAPHIC_ELEMENTS_HTTP_ENDPOINT=https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-graphic-elements-v1
# export YOLOX_GRAPHIC_ELEMENTS_INFER_PROTOCOL=http
# export YOLOX_TABLE_STRUCTURE_HTTP_ENDPOINT=https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-table-structure-v1
# export YOLOX_TABLE_STRUCTURE_INFER_PROTOCOL=http
# export APP_QUERYREWRITER_SERVERURL=""
# export APP_QUERYREWRITER_MODELNAME="nvidia/nemotron-3-ultra-550b-a55b"


# ==========================
# GPU IDs (local deployment)
# ==========================

# ==== LLM ====
export LLM_MS_GPU_ID=1

# ==== Embeddings ====
export EMBEDDING_MS_GPU_ID=0
export VLM_EMBEDDING_MS_GPU_ID=0

# ==== Reranker ====
export RANKING_MS_GPU_ID=0

# ==== Vector DB GPU ID ====
export VECTORSTORE_GPU_DEVICE_ID=0

# ==== Ingestion NIMs GPU ids ====
export YOLOX_MS_GPU_ID=0
export YOLOX_GRAPHICS_MS_GPU_ID=0
export YOLOX_TABLE_MS_GPU_ID=0
export OCR_MS_GPU_ID=0

# ==========================
# Paths
# ==========================

export PROMPT_CONFIG_FILE=${PWD}/src/nvidia_rag/rag_server/prompt.yaml

# ==========================
# Qwen H100 Local RAG Deployment
# ==========================
# This final section intentionally overrides the default self-hosted generation
# settings above. Use it with docker-compose-qwen-h100.yaml.
# Values below are deployment inputs, not validator constants. Safe custom
# values pass normal preflight but lose certified FP8/NVFP4 status. Keep GPU 0,
# required/excluded services, loopback ports, digests, healthchecks, restart
# policy, and resolved internal role endpoints unchanged.

export QWEN_MODEL_ID=Qwen/Qwen3.8-27B-FP8
export QWEN_MODEL_REVISION=017b9c7af6b5689d5dd426a76e0bc077eb5ca20a
export QWEN_SERVED_MODEL_NAME=Qwen/Qwen3.8-27B-FP8
export QWEN_MAX_MODEL_LEN=32768
export QWEN_GPU_MEMORY_UTILIZATION=0.48
export QWEN_MAX_NUM_SEQS=1
export QWEN_MAX_IMAGES_PER_PROMPT=3

# NVFP4 has its own certified model envelope. These remain configurable, but
# changing them makes the deployment custom until it is separately validated.
export QWEN_NVFP4_MODEL_ID=nvidia/Qwen3.6-35B-A3B-NVFP4
export QWEN_NVFP4_MODEL_REVISION=491c2f1ea524c639598bf8fa787a93fed5a6fbce
export QWEN_NVFP4_SERVED_MODEL_NAME=nvidia/Qwen3.6-35B-A3B-NVFP4
export QWEN_NVFP4_GPU_MEMORY_UTILIZATION=0.40

export APP_LLM_MODELNAME=Qwen/Qwen3.8-27B-FP8
export APP_LLM_SERVERURL=http://qwen-vllm:8000/v1
export APP_LLM_APIKEY=
export LLM_ENABLE_THINKING=false
export LLM_MAX_TOKENS=8192

export ENABLE_VLM_INFERENCE=true
export ENABLE_MULTIMODAL_ACCURACY=true
export ENABLE_MULTIMODAL_VERIFICATION_GATE=true
export ENABLE_MULTIMODAL_ABSTENTION_PROMPT=true
export VLM_TO_LLM_FALLBACK=false
export APP_VLM_MODELNAME=Qwen/Qwen3.8-27B-FP8
export APP_VLM_SERVERURL=http://qwen-vllm:8000/v1
export APP_VLM_APIKEY=
export APP_VLM_ENABLE_THINKING=false
export APP_VLM_MAX_TOTAL_IMAGES=3
export APP_VLM_MAX_TOKENS=8192

export APP_EMBEDDINGS_SERVERURL=http://nemotron-vlm-embedding-ms:8000/v1
export APP_EMBEDDINGS_MODELNAME=nvidia/llama-nemotron-embed-vl-1b-v2
export APP_EMBEDDINGS_DIMENSIONS=2048
export APP_RANKING_SERVERURL=http://nemotron-ranking-vl-ms:8000
export APP_RANKING_MODELNAME=nvidia/llama-nemotron-rerank-vl-1b-v2
export ENABLE_RERANKER=true
export ENABLE_VLM_RERANKER_IMAGE_INPUT=true

# Retrieval fan-out: APP_RETRIEVER_TOPK must not exceed VECTOR_DB_TOPK.
export VECTOR_DB_TOPK=100
export APP_RETRIEVER_TOPK=5

export APP_VECTORSTORE_URL=http://elasticsearch:9200
export APP_VECTORSTORE_NAME=elasticsearch
export APP_VECTORSTORE_ENABLEGPUINDEX=false
export APP_VECTORSTORE_ENABLEGPUSEARCH=false

export APP_NVINGEST_EXTRACTTEXT=true
export APP_NVINGEST_EXTRACTINFOGRAPHICS=true
export APP_NVINGEST_EXTRACTTABLES=true
export APP_NVINGEST_EXTRACTCHARTS=true
export APP_NVINGEST_EXTRACTIMAGES=true
export APP_NVINGEST_EXTRACTPAGEASIMAGE=false
export APP_NVINGEST_STRUCTURED_ELEMENTS_MODALITY=text_image
export APP_NVINGEST_IMAGE_ELEMENTS_MODALITY=image
export APP_NVINGEST_PDFEXTRACTMETHOD=None
export APP_NVINGEST_EXTRACTTABLESMETHOD=yolox
export APP_NVINGEST_SEGMENTAUDIO=false
export APP_NVINGEST_CAPTIONMODELNAME=Qwen/Qwen3.8-27B-FP8
export APP_NVINGEST_CAPTIONENDPOINTURL=http://qwen-vllm:8000/v1/chat/completions
export VLM_CAPTION_MODEL_NAME=Qwen/Qwen3.8-27B-FP8
export VLM_CAPTION_ENDPOINT=http://qwen-vllm:8000/v1/chat/completions

export ENABLE_QUERYREWRITER=true
export CONVERSATION_HISTORY=5
export APP_QUERYREWRITER_MODELNAME=Qwen/Qwen3.8-27B-FP8
export APP_QUERYREWRITER_SERVERURL=http://qwen-vllm:8000/v1
# Disabled 2026-08-13 after measuring it on a follow-up question. "介紹這個產品" took
# 30.5s with decomposition against 8.5s without, and the longer run produced a *shorter*
# answer (782 vs 937 chars). The query rewriter had already resolved the pronoun to
# "請介紹 JReality J7EF Plus ...", and decomposition then widened it into sub-questions
# about J9/J7M, launch dates, pricing and competitor comparisons that nobody asked for,
# each costing a full LLM call plus a whole-collection retrieval. Keep ENABLE_QUERYREWRITER
# on: that is the step that actually resolves follow-up pronouns.
export ENABLE_QUERY_DECOMPOSITION=false
export MAX_RECURSION_DEPTH=3
# Disabled 2026-08-13 after a measured failure: the generator asks an LLM to invent a
# metadata filter from the question, and for "提供J7EF Plus 的詳細規格" it produced
# filename == "J7EF Plus" while the real filename is
# "JORJIN TECHNOLOGIES-J7EF PULS 產品規格_v3.pdf". Nothing matched, retrieval returned
# zero documents, and self-reflection then burned all MAX_REFLECTION_LOOP rounds
# rewriting the query -- which can never repair a filter. Costs ~17s per agentic query.
export ENABLE_FILTER_GENERATOR=false
export APP_FILTEREXPRESSIONGENERATOR_MODELNAME=Qwen/Qwen3.8-27B-FP8
export APP_FILTEREXPRESSIONGENERATOR_SERVERURL=http://qwen-vllm:8000/v1
export APP_FILTEREXPRESSIONGENERATOR_MAXTOKENS=1024
export ENABLE_REFLECTION=true
export MAX_REFLECTION_LOOP=3
export REFLECTION_LLM=Qwen/Qwen3.8-27B-FP8
export REFLECTION_LLM_SERVERURL=http://qwen-vllm:8000/v1

export SUMMARY_LLM=Qwen/Qwen3.8-27B-FP8
export SUMMARY_LLM_SERVERURL=http://qwen-vllm:8000/v1
export SUMMARY_LLM_MAX_CHUNK_LENGTH=6144
export SUMMARY_MAX_PARALLELIZATION=1
export ENABLE_REDIS_BACKEND=true

# Disabled 2026-08-13: agentic mode measured 52.1s vs 17.7s for the same question with
# no quality gain (both returned complete specs; non-agentic also produced 8 citations).
# AGENTIC_CONCURRENCY_LIMIT=1 serialises every sub-task onto the one shared Qwen endpoint.
# Re-enable per request with "agentic": true when multi-step reasoning is actually needed.
export ENABLE_AGENTIC_RAG=false
export AGENTIC_CONCURRENCY_LIMIT=1
export AGENTIC_PLANNER_LLM_MODEL=Qwen/Qwen3.8-27B-FP8
export AGENTIC_PLANNER_LLM_SERVERURL=http://qwen-vllm:8000/v1
export AGENTIC_PLANNER_LLM_MAX_TOKENS=1024
export AGENTIC_TASK_LLM_MODEL=Qwen/Qwen3.8-27B-FP8
export AGENTIC_TASK_LLM_SERVERURL=http://qwen-vllm:8000/v1
export AGENTIC_TASK_LLM_MAX_TOKENS=1024
export AGENTIC_SEED_GEN_LLM_MODEL=Qwen/Qwen3.8-27B-FP8
export AGENTIC_SEED_GEN_LLM_SERVERURL=http://qwen-vllm:8000/v1
export AGENTIC_SEED_GEN_LLM_MAX_TOKENS=1024
export AGENTIC_SYNTHESIS_LLM_MODEL=Qwen/Qwen3.8-27B-FP8
export AGENTIC_SYNTHESIS_LLM_SERVERURL=http://qwen-vllm:8000/v1
export AGENTIC_SYNTHESIS_LLM_MAX_TOKENS=1024
export AGENTIC_CONTEXT_MAX_TOKENS=4096
export AGENTIC_VERIFICATION_ENABLED=true

export LLM_MS_GPU_ID=0
export VLM_EMBEDDING_MS_GPU_ID=0
export RANKING_VL_MS_GPU_ID=0
export YOLOX_MS_GPU_ID=0
export YOLOX_GRAPHICS_MS_GPU_ID=0
export YOLOX_TABLE_MS_GPU_ID=0
export OCR_MS_GPU_ID=0
export PAGE_ELEMENTS_BATCH_SIZE=1
export GRAPHIC_ELEMENTS_BATCH_SIZE=1
export TABLE_STRUCTURE_BATCH_SIZE=1
export OCR_BATCH_SIZE=1
export MAX_INGEST_PROCESS_WORKERS=1
export NV_INGEST_FILES_PER_BATCH=1
export NV_INGEST_CONCURRENT_BATCHES=1
export ENABLE_NV_INGEST_DYNAMIC_BATCHING=false
